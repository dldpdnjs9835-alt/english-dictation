rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Hall of Fame leaderboard requires public read access
    // But writing user profile & scores requires authentication, and users can only modify their OWN data!
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
